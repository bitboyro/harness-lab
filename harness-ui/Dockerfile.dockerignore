# Used when building with context = repo root and -f harness-ui/Dockerfile
# (Docker Engine ≥ 23 looks for <Dockerfile>.dockerignore beside the Dockerfile).

.git
**/.git

# Never send research archives or local results into the build
archive
results
traces
tmp
.venv
**/node_modules
**/.next
**/target
**/__pycache__
**/.pytest_cache
**/*.pyc
**/.DS_Store

# harness-ui local mount and secrets
harness-ui/harness-data
harness-ui/.env
.env

# Large / irrelevant at image build time
**/*.md
!harness-ui/adapter/**/*.md
docs
examples
tests
*.egg-info
dist
build
