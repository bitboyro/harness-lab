# Copy to .env and fill in. .env is gitignored; never commit a real key.
#   cp .env.example .env && $EDITOR .env

# Provider credentials. Only the one you are running needs a value.
OPENAI_API_KEY=

# Optional: an OpenAI-compatible endpoint other than api.openai.com
# (self-hosted vLLM, a gateway, or any compatible server).
# OPENAI_BASE_URL=

# The API under test, for field mode.
TARGET_BASE_URL=
